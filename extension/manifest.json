{
  "manifest_version": 3,
  "name": "ImotiAI Extractor",
  "version": "1.2.2",
  "description": "In-browser list detection and extraction (authorized use only).",
  "action": {
    "default_title": "ImotiAI Extractor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*",
    "https://imoti.info/*",
    "https://bazar.bg/*",
    "https://imoti.net/*",
    "https://www.imot.bg/*",
    "*://holmes.bg/*",
    "*://*.holmes.bg/*",
    "https://ues.bg/*",
    "https://www.ues.bg/*",
    "https://imoteka.bg/*",
    "https://address.bg/*",
    "https://www.luximmo.bg/*",
    "https://www.bulgarianproperties.bg/*",
    "https://www.mirela.bg/*",
    "https://www.homes2u.bg/*",
    "https://www.yavlena.com/*",
    "https://buildingbox.bg/*",
    "https://realistimo.com/*",
    "https://arcoreal.bg/*",
    "https://www.domaza.bg/*"

  ],
  "icons": {
    "16": "assets/icon-48.png",
    "32": "assets/icon-48.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-48.png"
  }
}
